blueprint:
  name: Smart Vacuum & Light Sync V1.10
  description: >
    This Home Assistant automation synchronizes your home lights with the movements of your robot vacuum.
    It automatically turns on the light in the room where the vacuum is cleaning or entering,
    and switches it off when the vacuum leaves or stops.
  domain: automation
  homeassistant:
    min_version: 2024.10.0
  input:
    vacuum_entity:
      name: "Vacuum entity"
      description: >
        Select your robot vacuum entity.

        Example: vacuum.l40s_pro_ultra
      selector:
        entity:
          domain: vacuum

    room_sensor:
      name: "Room sensor"
      description: >
        Sensor that reports the current room of the vacuum.

        Example: sensor.l40s_pro_ultra_current_room
      selector:
        entity:
          domain: sensor

    lights_mapping_text:
      name: "Room → Light mapping"
      description: >
        Mapping between room names and light entities (YAML or JSON).
        A room can point to a single light or to a list of lights.

        Example:

        {"Bathroom": "light.lumieres_sdb", "Living Room": ["light.salon_1", "light.salon_2"]}
      selector:
        object: {}

    presence_entities:
      name: "Presence entities (optional)"
      description: >
        Lights are only turned on when none of these persons is home.

        Example: person.vincent
      default: []
      selector:
        entity:
          domain: person
          multiple: true

    light_sensor:
      name: "Light sensor (optional)"
      description: >
        Sensor measuring ambient light (lux) to avoid turning lights on if already bright.
      default: ""
      selector:
        entity:
          domain: sensor
          device_class: illuminance

    light_threshold:
      name: "Light threshold (lux)"
      description: >
        Lights only turn on when the ambient light is at or below this value.
      default: 100
      selector:
        number:
          min: 0
          max: 10000
          unit_of_measurement: lx

    light_brightness:
      name: "Light brightness (optional)"
      description: >
        Brightness percentage for lights when turned on.

        Leave empty (or 0) to keep the last brightness of the light.
      default: ""
      selector:
        number:
          min: 0
          max: 100
          step: 1
          unit_of_measurement: "%"

triggers:
  # "to: ~" = only real state changes, attribute updates are ignored
  - trigger: state
    entity_id: !input room_sensor
    to: ~
    id: room
  - trigger: state
    entity_id: !input vacuum_entity
    to:
      - cleaning
      - returning
      - paused
      - idle
      - docked
      - error
    id: vacuum

variables:
  room_sensor: !input room_sensor
  vacuum_entity: !input vacuum_entity
  lights_raw: !input lights_mapping_text
  presence_entities: !input presence_entities
  light_sensor: !input light_sensor
  light_threshold: !input light_threshold
  light_brightness: !input light_brightness
  # Accepts both the new object input and the old JSON text input
  lights_map: >
    {{ lights_raw if lights_raw is mapping else (lights_raw | from_json(default={})) }}
  room: "{{ states(room_sensor) }}"
  previous_room: "{{ trigger.from_state.state if trigger.id == 'room' and trigger.from_state else '' }}"
  vacuum_state: "{{ states(vacuum_entity) }}"
  room_lights: "{{ lights_map.get(room, []) }}"
  previous_lights: "{{ lights_map.get(previous_room, []) if previous_room != room else [] }}"
  is_active: "{{ vacuum_state in ['cleaning', 'returning'] }}"
  can_turn_on: >
    {% set presence_ok = presence_entities | select('is_state', 'home') | list | count == 0 %}
    {% set lux_ok = light_sensor in ['', none]
       or states(light_sensor) | float(0) <= light_threshold | float(0) %}
    {{ presence_ok and lux_ok }}
  light_data: >
    {% set b = light_brightness | int(0) if light_brightness not in ['', none] else 0 %}
    {{ {'brightness_pct': b} if b > 0 else {} }}

actions:
  # 1. Vacuum left a room → turn its light off (never blocked by presence/lux)
  - if: "{{ previous_lights | length > 0 }}"
    then:
      - action: light.turn_off
        target:
          entity_id: "{{ previous_lights }}"

  # 2. Vacuum is cleaning/returning in a mapped room → turn light on
  - if: "{{ is_active and room_lights | length > 0 and can_turn_on }}"
    then:
      - action: light.turn_on
        target:
          entity_id: "{{ room_lights }}"
        data: "{{ light_data }}"

  # 3. Vacuum stopped → turn the current room light off (never blocked by presence/lux)
  - if: "{{ not is_active and room_lights | length > 0 }}"
    then:
      - action: light.turn_off
        target:
          entity_id: "{{ room_lights }}"

mode: queued
max: 10
max_exceeded: silent
